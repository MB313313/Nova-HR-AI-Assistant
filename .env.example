# Copy this file to .env and fill in the keys you have.

# --- LLM ---
# openai | gemini   (leave unset to auto-detect from whichever key is present)
LLM_PROVIDER=
# openai default: gpt-4o
# gemini default: gemini-2.0-flash
LLM_MODEL=
LLM_TEMPERATURE=0.2

OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- LangSmith (optional — the app works without this) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-assistant-nova

# Compatibility aliases used by some LangChain versions
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hr-assistant-nova
